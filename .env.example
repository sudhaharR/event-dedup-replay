# =====================================================
# Environment template - copy to .env and fill values
# DO NOT put real passwords in this file
# =====================================================

# ---------- MySQL (Docker) ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=event_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_app
MYSQL_PORT=3307

# ---------- AWS S3 (Stage 6) ----------
# ---------- AWS S3 ----------
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=dev/
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---------- Snowflake (Stage 8) ----------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=EVENT_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN
# =====================================================
# Environment template - copy to .env and fill values
# DO NOT put real passwords in this file
# =====================================================

# ---------- MySQL (Docker) ----------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=event_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_app
MYSQL_PORT=3307

# ---------- AWS S3 (Stage 6) ----------
# ---------- AWS S3 ----------
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=dev/
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---------- Snowflake (Stage 8) ----------
# ---------- Snowflake ----------
SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=EDR_APP
SNOWFLAKE_PRIVATE_KEY_FILE=../keys/snowflake_rsa_key.p8
SNOWFLAKE_WAREHOUSE=EDR_WH
SNOWFLAKE_DATABASE=EDR_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=EDR_APP_ROLE